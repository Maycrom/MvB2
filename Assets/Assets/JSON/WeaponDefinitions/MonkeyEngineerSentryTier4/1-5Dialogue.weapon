					"Movement": {"Type": "Forward","Direction": [0, -1],"Speed": 0.000001,"CutOffDistance": 0.00000003},
					
					"Text": "However, the clones are imperfect\nand won't be worth nearly\nas much as normal bananas."
				}	
			]
		},
