{	
    "Type":             "1-TutorialDialogue",    
    "TargetRange":      0.0,
	"CooldownTime":     0.02,
    "FireDelayTime":    0.01,
	"RequiresTargetToFire":	false,
    // This is unoptimised garbage but it should be fine and gets cleaned up anyways, legit just ain't worth the time investment
    "Tasks" :
    [
		{   
			// Dialogue 1
			"Type": "Effect","Position": [ 222, 220 ],"SpriteFile": "speech_bubble.json","Scale": 0,"Duration": 0.001,
			"Tasks":
			[
				{
					"Type": "TextEffect", "Font": "oetztype_22_black_stroke", "Colour": [ 1.0, 1.0, 1.0 ],
					"Movement": {"Type": "Forward","Direction": [0, -1],"Speed": 0.000001,"CutOffDistance": 0.00000003},
					
					"Text": "(Hover your cursor over the\narrow icon to continue\nthe conversation.)"
				}	
			]
		},
		{   
			// Dialogue 2
			"Type": "Effect","Position": [ 222, 220 ],"SpriteFile": "speech_bubble.json","Scale": 0,"Duration": 0.001, "DisabledTasks": [0,1,2],
			"Tasks":
			[
				{
					"Type": "TextEffect", "Font": "oetztype_22_black_stroke", "Colour": [ 1.0, 1.0, 1.0 ],
					"Movement": {"Type": "Forward","Direction": [0, -1],"Speed": 0.000001,"CutOffDistance": 0.00000003},
					
					"Text": "You're learning fast, that's\ngood, you've got big shoes to\nfill in your new role."
				}	
			]
		},
		{   
			// Dialogue 3
			"Type": "Effect","Position": [ 222, 220 ],"SpriteFile": "speech_bubble.json","Scale": 0,"Duration": 0.001, "DisabledTasks": [0,1,2],
			"Tasks":
			[
				{
					"Type": "TextEffect", "Font": "oetztype_22_black_stroke", "Colour": [ 1.0, 1.0, 1.0 ],
					"Movement": {"Type": "Forward","Direction": [0, -1],"Speed": 0.000001,"CutOffDistance": 0.00000003},
					
					"Text": "I used to be like you, but\nI'm partially retired now."
				}	
			]
		},
		{   
			// Dialogue 4
			"Type": "Effect","Position": [ 222, 220 ],"SpriteFile": "speech_bubble.json","Scale": 0,"Duration": 0.001, "DisabledTasks": [0,1,2],
			"Tasks":
			[
				{
					"Type": "TextEffect", "Font": "oetztype_22_black_stroke", "Colour": [ 1.0, 1.0, 1.0 ],
					"Movement": {"Type": "Forward","Direction": [0, -1],"Speed": 0.000001,"CutOffDistance": 0.00000003},
					
					"Text": "Let's get into your training,\nshall we?"
				}	
			]
		},
		{   
			// Dialogue 5
			"Type": "Effect","Position": [ 222, 220 ],"SpriteFile": "speech_bubble.json","Scale": 0,"Duration": 0.001, "DisabledTasks": [0,1,2],
			"Tasks":
			[
				{
					"Type": "TextEffect", "Font": "oetztype_22_black_stroke", "Colour": [ 1.0, 1.0, 1.0 ],
					"Movement": {"Type": "Forward","Direction": [0, -1],"Speed": 0.000001,"CutOffDistance": 0.00000003},
					
					"Text": "See those white squares\nup there?"
				}	
			]
		},
		{   
			// Dialogue 6
			"Type": "Effect","Position": [ 222, 220 ],"SpriteFile": "speech_bubble.json","Scale": 0,"Duration": 0.001, "DisabledTasks": [0,1,2],
			"Tasks":
			[
				{
					"Type": "TextEffect", "Font": "oetztype_22_black_stroke", "Colour": [ 1.0, 1.0, 1.0 ],
					"Movement": {"Type": "Forward","Direction": [0, -1],"Speed": 0.000001,"CutOffDistance": 0.00000003},
					
					"Text": "Those are called Tower Slots."
				}	
			]
		},
		{   
			// Dialogue 7
			"Type": "Effect","Position": [ 222, 220 ],"SpriteFile": "speech_bubble.json","Scale": 0,"Duration": 0.001, "DisabledTasks": [0,1,2],
			"Tasks":
			[
				{
					"Type": "TextEffect", "Font": "oetztype_22_black_stroke", "Colour": [ 1.0, 1.0, 1.0 ],
					"Movement": {"Type": "Forward","Direction": [0, -1],"Speed": 0.000001,"CutOffDistance": 0.00000003},
					
					"Text": "Before you start fighting\nthe bloons, you will have to\nplace the towers you want\nto use in there."
				}	
			]
		},
		{   
			// Dialogue 8
			"Type": "Effect","Position": [ 222, 220 ],"SpriteFile": "speech_bubble.json","Scale": 0,"Duration": 0.001, "DisabledTasks": [0,1,2],
			"Tasks":
			[
				{
					"Type": "TextEffect", "Font": "oetztype_22_black_stroke", "Colour": [ 1.0, 1.0, 1.0 ],
					"Movement": {"Type": "Forward","Direction": [0, -1],"Speed": 0.000001,"CutOffDistance": 0.00000003},
					
					"Text": "Make sure to bring towers that\nstrategically aid you in\nyour mission.\nBad choices could end... badly."
				}	
			]
		},
		{   
			// Dialogue 9
			"Type": "Effect","Position": [ 222, 220 ],"SpriteFile": "speech_bubble.json","Scale": 0,"Duration": 0.001, "DisabledTasks": [0,1,2],
			"Tasks":
			[
				{
					"Type": "TextEffect", "Font": "oetztype_22_black_stroke", "Colour": [ 1.0, 1.0, 1.0 ],
					"Movement": {"Type": "Forward","Direction": [0, -1],"Speed": 0.000001,"CutOffDistance": 0.00000003},
					
					"Text": "You don't have much to choose\nfrom right now but your arsenal\nwill only keep growing\nfrom here."
				}	
			]
		},
		{   
			// Dialogue 10
			"Type": "Effect","Position": [ 222, 220 ],"SpriteFile": "speech_bubble.json","Scale": 0,"Duration": 0.001, "DisabledTasks": [0,1,2],
			"Tasks":
			[
				{
					"Type": "TextEffect", "Font": "oetztype_22_black_stroke", "Colour": [ 1.0, 1.0, 1.0 ],
					"Movement": {"Type": "Forward","Direction": [0, -1],"Speed": 0.000001,"CutOffDistance": 0.00000003},
					
					"Text": "Why don't you try it out?\nTry placing a Dart Monkey into\none of the Tower Slots."
				}	
			]
		},
		{   
			// Dialogue 11
			"Type": "Effect","Position": [ 222, 220 ],"SpriteFile": "speech_bubble.json","Scale": 0,"Duration": 0.001, "DisabledTasks": [0,1,2],
			"Tasks":
			[
				{
					"Type": "TextEffect", "Font": "oetztype_22_black_stroke", "Colour": [ 1.0, 1.0, 1.0 ],
					"Movement": {"Type": "Forward","Direction": [0, -1],"Speed": 0.000001,"CutOffDistance": 0.00000003},
					
					"Text": "Good job!\nThe Dart Monkey is now\npart of this mission."
				}	
			]
		},
		{   
			// Dialogue 12
			"Type": "Effect","Position": [ 222, 220 ],"SpriteFile": "speech_bubble.json","Scale": 0,"Duration": 0.001, "DisabledTasks": [0,1,2],
			"Tasks":
			[
				{
					"Type": "TextEffect", "Font": "oetztype_22_black_stroke", "Colour": [ 1.0, 1.0, 1.0 ],
					"Movement": {"Type": "Forward","Direction": [0, -1],"Speed": 0.000001,"CutOffDistance": 0.00000003},
					
					"Text": "Every tower you bring has a\ncooldown attached to it.\nOnce you place it down, it will\ngo on cooldown."
				}	
			]
		},
		{   
			// Dialogue 13
			"Type": "Effect","Position": [ 222, 220 ],"SpriteFile": "speech_bubble.json","Scale": 0,"Duration": 0.001, "DisabledTasks": [0,1,2],
			"Tasks":
			[
				{
					"Type": "TextEffect", "Font": "oetztype_22_black_stroke", "Colour": [ 1.0, 1.0, 1.0 ],
					"Movement": {"Type": "Forward","Direction": [0, -1],"Speed": 0.000001,"CutOffDistance": 0.00000003},
					
					"Text": "You should also keep in mind\nthat your towers can only\nhandle so much heat.\nIf the bloons get too close\nthey will be forced to retreat."
				}	
			]
		},
		{   
			// Dialogue 14
			"Type": "Effect","Position": [ 222, 220 ],"SpriteFile": "speech_bubble.json","Scale": 0,"Duration": 0.001, "DisabledTasks": [0,1,2],
			"Tasks":
			[
				{
					"Type": "TextEffect", "Font": "oetztype_22_black_stroke", "Colour": [ 1.0, 1.0, 1.0 ],
					"Movement": {"Type": "Forward","Direction": [0, -1],"Speed": 0.000001,"CutOffDistance": 0.00000003},
					
					"Text": "During your missions, I will\nmake sure to keep supplies\ncoming, so you can keep\ngrowing your defense."
				}	
			]
		},
		{   
			// Dialogue 15
			"Type": "Effect","Position": [ 222, 220 ],"SpriteFile": "speech_bubble.json","Scale": 0,"Duration": 0.001, "DisabledTasks": [0,1,2],
			"Tasks":
			[
				{
					"Type": "TextEffect", "Font": "oetztype_22_black_stroke", "Colour": [ 1.0, 1.0, 1.0 ],
					"Movement": {"Type": "Forward","Direction": [0, -1],"Speed": 0.000001,"CutOffDistance": 0.00000003},
					
					"Text": "However this won't be enough,\nyou'll have to look into\nalternative solutions as well.\nI'm sure you'll figure\nit out soon enough!"
				}	
			]
		},
		{   
			// Dialogue 16
			"Type": "Effect","Position": [ 222, 220 ],"SpriteFile": "speech_bubble.json","Scale": 0,"Duration": 0.001, "DisabledTasks": [0,1,2],
			"Tasks":
			[
				{
					"Type": "TextEffect", "Font": "oetztype_22_black_stroke", "Colour": [ 1.0, 1.0, 1.0 ],
					"Movement": {"Type": "Forward","Direction": [0, -1],"Speed": 0.000001,"CutOffDistance": 0.00000003},
					
					"Text": "Well, what are you waiting for?\nGo fight those bloons!"
				}	
			]
		}
	]
}